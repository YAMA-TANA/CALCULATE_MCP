{
  "name": "calculate-mcp",
  "version": "0.1.0",
  "description": "A deterministic calculation MCP server for expressions, decimals, units, statistics, percentages, finance, and numerical root solving.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "calculate-mcp": "dist/stdio.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "decimal.js": "^10.6.0",
    "expr-eval": "^2.0.2",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "calculator",
    "math",
    "units",
    "statistics"
  ]
}
